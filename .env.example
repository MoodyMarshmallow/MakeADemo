# Persistence
DATABASE_URL=postgres://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require

# Artifact storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=owlet

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_REDIRECT_URL=http://localhost:5173/github/callback

# Local API
API_PORT=8787

# MakeADemo Pipeline with the Pi Agent Harness and Daytona workspaces
DAYTONA_API_KEY=
# Legacy deployment name retained for existing benchmark configuration; the image is provider-neutral.
MAKEADEMO_DAYTONA_SNAPSHOT=makeademo-opencode-linked-ca-20260703
MAKEADEMO_DAYTONA_SUBMITTED_CODE_SNAPSHOT=makeademo-submitted-code-browser-ca-20260703

# Opt-in Railway Sandbox Phase 0 proof of concept
# Use a project token scoped to the dedicated Sandbox execution environment.
MAKEADEMO_RAILWAY_SANDBOX_PROJECT_TOKEN=
MAKEADEMO_RAILWAY_SANDBOX_ENVIRONMENT_ID=

# Hard gate for the Railway Demo Runtime Preflight canary. The spike reads only
# these dedicated names; it never reads ambient RAILWAY_API_TOKEN, RAILWAY_TOKEN,
# or RAILWAY_ENVIRONMENT_ID.
RUN_RAILWAY_SANDBOX_SPIKE=0

# Hard gate for the Railway two-sandbox ready-and-first-exec benchmark. It uses
# the dedicated token/environment above and runs 20 samples by default.
RUN_RAILWAY_SANDBOX_LATENCY_BENCHMARK=0
# Optional integer from 20 through 100.
MAKEADEMO_RAILWAY_SANDBOX_BENCHMARK_SAMPLES=20

OPENAI_API_KEY=
REPO_PREPARATION_PROVIDER_ID=openai
REPO_PREPARATION_MODEL_ID=gpt-5.6-terra

# Optional pipeline limits and retry budgets
MAKEADEMO_REPO_PREPARATION_TIMEOUT_MS=
MAKEADEMO_CAPTURE_PATH_REPAIR_ATTEMPTS=3
MAKEADEMO_DRAFT_COMPOSITE_REVIEW_ATTEMPTS=2
MAKEADEMO_MAX_DRAFT_COMPOSITE_SECONDS=120
MAKEADEMO_MAX_SCENE_CLIP_SECONDS=30

# Background pipeline worker
DEMO_QUEUE_POLL_INTERVAL_MS=5000
DEMO_QUEUE_WORKER_ONCE=0

# Final video delivery
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="MakeADemo <demo@your-domain.com>"
PUBLIC_APP_BASE_URL=https://make-a-demo.com
FINAL_VIDEO_EMAILS_ENABLED=false
